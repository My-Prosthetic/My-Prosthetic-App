# ==============================================================================
# Mobile Application Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the root directory:
#    cp .env.example .env
# 2. Update the values below according to your local development environment.
# Note: Any variable prefixed with EXPO_PUBLIC_ is embedded in client builds.
# Never store confidential API secrets or private keys here.
# ==============================================================================

# Backend API Base URL
# - Local Docker setup (Physical Device on same Wi-Fi): http://<YOUR_LOCAL_IP>:8080/api
# - Android Emulator (accessing host machine): http://10.0.2.2:8080/api
# - iOS Simulator (accessing host machine): http://localhost:8080/api
# - Remote Staging/Production: https://api.yourdomain.com/api
EXPO_PUBLIC_API_URL=http://localhost:8080/api