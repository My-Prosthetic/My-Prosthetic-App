{
	"expo": {
		"name": "MyProsthetics_local",
		"slug": "MyProsthetics_local",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/branding/icon-ios.png",
		"userInterfaceStyle": "light",
		"scheme": "your-app-scheme",
		"ios": {
			"icon": "./assets/branding/icon-ios.png",
			"supportsTablet": true
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#065A8E",
				"foregroundImage": "./assets/branding/icon-foreground.png",
				"monochromeImage": "./assets/branding/icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false,
			"package": "com.myprosthethicapp.MyProsthetics_local"
		},
		"web": {
			"favicon": "./assets/branding/icon-ios.png"
		},
		"experiments": {
			"typedRoutes": true
		},
		"plugins": [
			"expo-router",
			"expo-status-bar",
			"expo-sqlite",
			"expo-font",
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#065A8E",
					"image": "./assets/branding/splash-ios.png",
					"imageWidth": 560,
					"resizeMode": "contain",
					"android": {
						"image": "./assets/branding/splash-mark.png",
						"imageWidth": 168
					},
					"dark": { "backgroundColor": "#065A8E" }
				}
			],
			[
				"expo-audio",
				{
					"microphonePermission": "Allow MyProsthetics to record voice notes."
				}
			],
			[
				"expo-image-picker",
				{
					"photosPermission": "Allow MyProsthetics to access photos for your files and documentation.",
					"cameraPermission": "Allow MyProsthetics to take photos for your files and documentation."
				}
			],
			"expo-secure-store",
			"expo-sharing",
			"expo-asset",
			[
				"expo-build-properties",
				{
					"android": {
						"usesCleartextTraffic": true
					}
				}
			],
			"expo-build-properties",
			"expo-sharing"
		],
		"extra": {
			"router": {},
			"eas": {
				"projectId": "e54e6169-31d2-4197-ae42-5e3a2e74106e"
			}
		},
		"runtimeVersion": {
			"policy": "appVersion"
		},
		"updates": {
			"url": "https://u.expo.dev/e54e6169-31d2-4197-ae42-5e3a2e74106e"
		}
	}
}
