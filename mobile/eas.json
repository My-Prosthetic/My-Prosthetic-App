{
	"cli": {
		"version": ">=5.9.0",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"android": {
				"buildType": "apk"
			},
			"channel": "development"
		},
		"preview": {
			"autoIncrement": true,
			"distribution": "internal",
			"android": {
				"buildType": "apk"
			},
			"channel": "preview"
		},
		"production": {
			"autoIncrement": true,
			"android": {
				"buildType": "app-bundle"
			},
			"channel": "production"
		},
		"production-apk": {
			"extends": "production",
			"android": {
				"buildType": "apk"
			}
		}
	},
	"submit": {
		"production": {}
	}
}
